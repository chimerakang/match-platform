; Godot port of platform-shooter (multiplayer). Phase A: client skeleton that
; connects to the existing Node `ws` server (netgame/server.js).
; Config version 5 = Godot 4.x.

config_version=5

[application]

config/name="Match Platform (+ neon-shooter reference game)"
run/main_scene="res://games/neon-shooter/client/arena.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://games/neon-shooter/client/icon.svg"

[autoload]

AiTestServer="*res://games/neon-shooter/client/ai_test_server.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/stretch/mode="canvas_items"

